*.sh text eol=lf
*.py text eol=lf
Dockerfile* text eol=lf
*.md text eol=lf

*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Vendored unified diffs have meaningful single-space context lines.
ultra/source/lmcache/patches/packed4d.patch text eol=lf -whitespace
ultra/source/lmcache/patches/LICENSE text eol=lf

# Keep publication filters consistent across Windows and Linux.
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# The Next installer verifies exact payload bytes against its SHA256 manifest.
# Preserve the tested payload, including files captured with CRLF endings.
docker/next/overlay/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docker/next/templates/*.jinja text eol=lf
docker/helpers/runtime-env.list text eol=lf
docs/models/*.sha256 text eol=lf

# Preserve pinned upstream benchmark pack bytes and SHA256 identities.
ultra/source/benchlocal-native/packs/** -text

*.cjs text eol=lf
*.lock text eol=lf
**/LICENSE text eol=lf
ultra/source/benchlocal-native/packs/** -text

# Preserve the byte-pinned TP4 runtime and PCIe-IPC backport.
docker/next/tp4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.go text eol=lf
ultra/source/benchlocal-verifiers/LICENSE-Moby-profiles text eol=lf
