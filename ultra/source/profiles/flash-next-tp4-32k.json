{
  "id": "flash-next-tp4-32k",
  "name": "Flash Next · TP4 · FP8 KV · HC0 · PCIe-IPC · 32K",
  "format": "awq",
  "args": [
    "${MODEL}",
    "--served-model-name",
    "qwen3.8-next",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--dtype",
    "float16",
    "--tensor-parallel-size",
    "4",
    "--distributed-executor-backend",
    "mp",
    "--enable-expert-parallel",
    "--enable-ep-weight-filter",
    "--language-model-only",
    "--gpu-memory-utilization",
    "0.95",
    "--max-num-batched-tokens",
    "4096",
    "--max-num-seqs",
    "1",
    "--mamba-cache-mode",
    "align",
    "--offload-backend",
    "prefetch",
    "--offload-group-size",
    "48",
    "--offload-num-in-group",
    "20",
    "--offload-params",
    "w13_qweight",
    "w2_qweight",
    "w13_scales",
    "w2_scales",
    "w13_qzeros",
    "w2_qzeros",
    "--compilation-config",
    "{\"mode\": 0, \"cudagraph_mode\": \"PIECEWISE\", \"cudagraph_capture_sizes\": [1], \"max_cudagraph_capture_size\": 1, \"cudagraph_num_of_warmups\": 1}",
    "--generation-config",
    "vllm",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_xml",
    "--reasoning-parser",
    "qwen3",
    "--enable-prompt-tokens-details",
    "--max-model-len",
    "32768",
    "--kv-cache-memory-bytes",
    "536870912",
    "--hf-overrides",
    "{\"dtype\":\"float16\"}",
    "--kv-cache-dtype",
    "fp8_e4m3",
    "--block-size",
    "16",
    "--chat-template",
    "/opt/vllm-sm75/templates/qwen38-next-high-compat.jinja",
    "--gdn-prefill-backend",
    "flashqla_sm75",
    "--enable-prefix-caching",
    "--auto-sleep-idle-timeout",
    "0"
  ],
  "env": {
    "NCCL_P2P_LEVEL": "SYS",
    "CUDA_VISIBLE_DEVICES": "0,1,2,3",
    "VLLM_USE_MODELSCOPE": "true",
    "VLLM_FIREFLY": "auto",
    "VLLM_SM75_QWEN38_HC_GEMV": "0",
    "TP4_NEXT_RUNTIME": "1",
    "TP4_PIN_HOT": "1",
    "TP4_FAST_ROUTE": "1",
    "TP4_VERIFY": "0",
    "SM75_NEXT_RUNTIME_REV": "v017-unified-tp4-20261010",
    "SM75_PLE_KEEP_OS_CACHE": "1",
    "SM75_PLE_STORE": "/ple-store",
    "SM75_PLE_MODEL": "${MODEL}",
    "PYTORCH_ALLOC_CONF": "expandable_segments:False",
    "VLLM_WEIGHT_OFFLOADING_DISABLE_PIN_MEMORY": "1",
    "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE": "134217728",
    "VLLM_USE_BREAKABLE_CUDAGRAPH": "1",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_USE_FLASHINFER_SAMPLER": "0",
    "HF_HUB_OFFLINE": "1",
    "MAX_JOBS": "2",
    "NCCL_DEBUG": "WARN",
    "NCCL_SOCKET_IFNAME": "lo",
    "GLOO_SOCKET_IFNAME": "lo",
    "VLLM_SPARSE_INDEXER_MAX_LOGITS_MB": "16",
    "TP4_EXPERT_CACHE_CAPACITY": "256",
    "TP4_CONTROL_FILE": "/data/tp4-control.json",
    "VLLM_SM75_QSA_FP8_MAIN_KV": "1",
    "VLLM_SM75_QSA_SHARED_TARGET_SCRATCH": "1",
    "VLLM_SM75_QSA_CUBLAS_INDEXER": "0",
    "VLLM_SM75_QSA_FLASHINFER_PREFILL": "1",
    "VLLM_SM75_QSA_SELECTED_PAGES_PREFILL": "1",
    "VLLM_SM75_QSA_MIXED_PREFILL": "0",
    "VLLM_ENFORCE_STRICT_TOOL_CALLING": "1",
    "OMP_NUM_THREADS": "1",
    "VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC": "1"
  },
  "power": {
    "mode": "pstate",
    "idleSeconds": 10,
    "util": 5,
    "confirm": 60,
    "low": 8,
    "high": 16,
    "poll": 1,
    "gpus": "0,1,2,3"
  },
  "modelFamily": "qwen4_exp",
  "defaultModel": "/models/Qwen3.8-Flash-Next-W4A16-FP8PLE"
}
