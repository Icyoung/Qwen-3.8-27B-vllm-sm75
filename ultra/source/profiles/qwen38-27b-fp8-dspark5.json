{
  "id": "qwen38-27b-fp8-dspark5",
  "name": "Qwen3.8 27B · FP8 · DSpark k5 · 256K / seq4",
  "modelFamily": "qwen3_5",
  "defaultModel": "/models/Qwen3.8-27B-FP8",
  "defaultDraftModel": "/models/Qwen3.8-27B-DSpark",
  "format": "fp8",
  "args": [
    "${MODEL}",
    "--served-model-name",
    "VLLM-Qwen3.8-27B",
    "--dtype",
    "float16",
    "--hf-overrides",
    {
      "dtype": "float16"
    },
    "--tensor-parallel-size",
    "4",
    "--gpu-memory-utilization",
    "0.92",
    "--kv-cache-dtype",
    "fp8_e4m3",
    "--attention-config",
    {
      "backend": "FLASHINFER"
    },
    "--gdn-prefill-backend",
    "flashqla_sm75",
    "--block-size",
    "32",
    "--async-scheduling",
    "--disable-custom-all-reduce",
    "--enable-prompt-tokens-details",
    "--generation-config",
    "vllm",
    "--host",
    "0.0.0.0",
    "--port",
    "8000",
    "--auto-sleep-idle-timeout",
    "0",
    "--speculative-config",
    {
      "method": "dspark",
      "model": "${DRAFT_MODEL}",
      "num_speculative_tokens": 5,
      "draft_tensor_parallel_size": 4,
      "kv_cache_dtype": "auto",
      "attention_backend": "FLASHINFER",
      "draft_sample_method": "probabilistic",
      "rejection_sample_method": "standard",
      "enable_adaptive_verification": false
    },
    "--scheduler-cls",
    "vllm.v1.core.sched.scheduler_sm75.SM75Scheduler",
    "--language-model-only",
    "--enable-auto-tool-choice",
    "--tool-call-parser",
    "qwen3_coder",
    "--reasoning-parser",
    "qwen3",
    "--max-model-len",
    262144,
    "--max-num-seqs",
    4,
    "--max-num-batched-tokens",
    2048,
    "--kv-cache-memory-bytes",
    4831838208,
    "--enable-prefix-caching",
    "--mamba-cache-mode",
    "align",
    "--compilation-config",
    {
      "cudagraph_mode": "FULL_AND_PIECEWISE",
      "cudagraph_capture_sizes": [
        6,
        12,
        18,
        24
      ]
    }
  ],
  "env": {
    "CUDA_VISIBLE_DEVICES": "0,1,2,3",
    "NCCL_P2P_LEVEL": "SYS",
    "NCCL_IB_DISABLE": "1",
    "NCCL_DEBUG": "WARN",
    "VLLM_USE_MODELSCOPE": "false",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "OMP_NUM_THREADS": "2",
    "MAX_JOBS": "1",
    "NVCC_THREADS": "1",
    "TORCHINDUCTOR_COMPILE_THREADS": "1",
    "VLLM_MARLIN_USE_ATOMIC_ADD": "1",
    "VLLM_GDN_DECODE_KERNEL": "triton",
    "VLLM_USE_FLASHINFER_SAMPLER": "0",
    "VLLM_USE_NCCL_SYMM_MEM": "0",
    "VLLM_ALLREDUCE_USE_SYMM_MEM": "0",
    "VLLM_ALLREDUCE_USE_FLASHINFER": "0",
    "VLLM_FIREFLY": "1",
    "VLLM_FIREFLY_AR": "auto",
    "VLLM_FIREFLY_AR_BACKEND": "auto",
    "VLLM_USE_V2_MODEL_RUNNER": "1",
    "VLLM_SPEC_DECODE": "1",
    "SM75_FA2_SMALLQ_GRAPH": "1",
    "SM75_GDN_B1_METADATA": "1",
    "VLLM_USE_BREAKABLE_CUDAGRAPH": "0",
    "TORCH_COMPILE_DISABLE": "0"
  },
  "power": {
    "mode": "pstate",
    "idleSeconds": 1,
    "util": 5,
    "confirm": 0,
    "low": 8,
    "high": 16,
    "poll": 5,
    "gpus": "0,1,2,3"
  }
}
